{
  "name": "demo-app-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright E2E tests (POM + Allure) for the Insurance Claims Management demo app",
  "scripts": {
    "clean:allure-results": "rimraf allure-results",
    "clean:allure-report": "rimraf allure-report",
    "clean:allure": "rimraf allure-results allure-report",
    "test": "npm run clean:allure-results && playwright test",
    "test:smoke": "npm run clean:allure-results && playwright test --grep @smoke",
    "test:headed": "npm run clean:allure-results && playwright test --headed",
    "test:ui": "npm run clean:allure-results && playwright test --ui",
    "test:auth": "npm run clean:allure-results && playwright test tests/auth",
    "test:claims": "npm run clean:allure-results && playwright test tests/claims",
    "report:allure": "npm run report:allure:generate && allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:playwright": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "allure-commandline": "^2.33.0",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "rimraf": "^6.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
